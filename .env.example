# Copy to .env and fill in real values. .env is gitignored.

# --- Data providers ---
FMP_API_KEY=your_fmp_starter_key_here

# --- Kite Connect (Zerodha) ---
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
FRONTEND_URL=http://localhost:3000
FRED_API_KEY=your_fred_api_key_here
NEWSAPI_KEY=your_newsapi_dev_key_here

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database ---
DATABASE_URL=sqlite:///data/market.db

# --- Paths ---
DATA_DIR=./data
LOG_DIR=./logs
OFFICIAL_INDIA_DATA_DIR=./data/official_india

# --- Runtime ---
LOG_LEVEL=INFO
ENVIRONMENT=development
OFFICIAL_INDIA_AUTO_FETCH_ENABLED=true
OFFICIAL_INDIA_AUTO_FETCH_BATCH_SIZE=500
OFFICIAL_INDIA_AUTO_FETCH_LIMIT=8
OFFICIAL_INDIA_AUTO_FETCH_STATEMENT_SCOPE=consolidated
