# Copy to .env and fill in real values. .env is gitignored.

# --- Data providers ---
FMP_API_KEY=your_fmp_starter_key_here
FRED_API_KEY=your_fred_api_key_here
NEWSAPI_KEY=your_newsapi_dev_key_here

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database ---
DATABASE_URL=sqlite:///data/market.db

# --- Paths ---
DATA_DIR=./data
LOG_DIR=./logs

# --- Runtime ---
LOG_LEVEL=INFO
ENVIRONMENT=development
